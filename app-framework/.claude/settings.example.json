{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash drop*)",
      "Bash(git tag *)",
      "Bash(rm -rf*)",
      "Bash(rm -r *)",
      "Bash(Remove-Item * -Recurse*)",
      "Bash(<PLATFORM_CLI> deploy*)",
      "Bash(<PLATFORM_CLI> upload*)",
      "Bash(<PLATFORM_CLI> delete*)",
      "Bash(<PLATFORM_CLI> uninstall*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git worktree list*)",
      "Bash(npm run typecheck*)",
      "Bash(npm test*)",
      "Bash(npm run build*)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/pre-bash-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/pre-commit-checks.sh\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
